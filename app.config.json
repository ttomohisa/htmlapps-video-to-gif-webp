{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Video to GIF / WebP",
  "nameJa": "動画をGIF / WebPに変換",
  "slug": "video-to-gif-webp",
  "version": "1.0.3",
  "description": "Create animated GIF or WebP files from a selected range of a video entirely in your browser.",
  "descriptionJa": "動画の好きな範囲を、ブラウザー内だけでアニメーションGIFまたはWebPに変換します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-video-to-gif-webp"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    }
  }
}
